meta {
  name: Abrir ticket para superar tope
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/tickets
  body: json
  auth: none
}

body:json {
  {
    "placa": "P888MAX",
    "entrada": "2026-10-22T08:00:00"
  }
}

assert {
  res.status: eq 201
  res.body.placa: eq P888MAX
}

script:post-response {
  bru.setVar("topeSuperadoId", res.body.id);
}
