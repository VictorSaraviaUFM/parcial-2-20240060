meta {
  name: Abrir ticket para tope exacto
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/tickets
  body: json
  auth: none
}

body:json {
  {
    "placa": "C777TOP",
    "entrada": "2026-10-22T08:00:00"
  }
}

assert {
  res.status: eq 201
  res.body.placa: eq C777TOP
}

script:post-response {
  bru.setVar("topeExactoId", res.body.id);
}
